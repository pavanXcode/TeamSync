# TeamSync — Backend Environment Configuration Example
# Copy this file to .env and supply your personal GitHub token and repository details.

# GitHub Repository Owner (Organization or Username)
# Example: GITHUB_OWNER=octocat
GITHUB_OWNER=

# GitHub Repository Name
# Example: GITHUB_REPO=Hello-World
GITHUB_REPO=

# GitHub Personal Access Token (PAT)
# Minimum Read Permissions Required:
# - Classic PAT: "repo" (for private repositories) or "public_repo" (for public repositories)
# - Fine-Grained PAT:
#     - Repository permissions -> Issues: Read-only
#     - Repository permissions -> Pull requests: Read-only
# NEVER commit your actual token to version control.
GITHUB_TOKEN=

# Optional: Custom JSON mapping for GitHub username -> Employee ID
# Example: GITHUB_EMPLOYEE_MAPPINGS={"octocat": 1, "hubot": 2}
GITHUB_EMPLOYEE_MAPPINGS=
